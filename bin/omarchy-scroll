#!/bin/bash

# omarchy-scroll — read, preview, and persist mouse/touchpad scroll settings.
#
# Live changes go through `hyprctl eval`, which Hyprland forgets on the next
# reload. Persistence is a generated ~/.config/hypr/scroll.lua, required from
# input.lua so it loads after Omarchy's defaults and wins.
#
# Consent model: the only file this script ever creates or rewrites on its own
# is scroll.lua, which it owns (and it refuses to touch one it did not
# generate). input.lua belongs to the user and is only edited by the explicit
# `enable` command (the panel's "Keep across reloads" button), which appends a
# single marked line; `disable` removes exactly that line again.

set -o pipefail

SCROLL_LUA="$HOME/.config/hypr/scroll.lua"
INPUT_LUA="$HOME/.config/hypr/input.lua"
HEADER="-- Generated by omarchy-scroll."
REQUIRE_LINE='require("hypr.scroll") -- omarchy-scroll'
REQUIRE_COMMENT="-- Mouse/trackpad scroll settings, managed by omarchy-scroll."

usage() {
  cat <<USAGE
Usage: omarchy-scroll <command>

  get              Print current settings as JSON
  set <key> <val>  Apply live (not persisted)
  save             Write the current live values to scroll.lua
  enable           Load scroll.lua on every reload (adds one line to input.lua)
  disable          Remove that line from input.lua again
  reset            Empty scroll.lua and reload, back to Omarchy defaults
  uninstall        disable + delete scroll.lua + reload (run before removing)
  path             Print the generated config path

Keys: mouse-factor mouse-natural pad-factor pad-natural scroll-method
      emulate-discrete
USAGE
}

# key -> hyprland option, and how to read it back out of `hyprctl getoption`
opt_for() {
  case "$1" in
    mouse-factor)     echo "input:scroll_factor float" ;;
    mouse-natural)    echo "input:natural_scroll bool" ;;
    pad-factor)       echo "input:touchpad:scroll_factor float" ;;
    pad-natural)      echo "input:touchpad:natural_scroll bool" ;;
    scroll-method)    echo "input:scroll_method str" ;;
    emulate-discrete) echo "input:emulate_discrete_scroll int" ;;
    *) return 1 ;;
  esac
}

read_opt() {
  local spec opt kind raw
  spec=$(opt_for "$1") || return 1
  opt=${spec%% *}; kind=${spec##* }
  raw=$(hyprctl -j getoption "$opt" 2>/dev/null) || return 1
  case "$kind" in
    float) jq -r '.float' <<<"$raw" ;;
    bool)  jq -r '.bool'  <<<"$raw" ;;
    int)   jq -r '.int'   <<<"$raw" ;;
    # An unset string option reads back as the [[EMPTY]] sentinel, not "".
    str)   jq -r 'if .str == "[[EMPTY]]" then "" else .str end' <<<"$raw" ;;
  esac
}

cmd_get() {
  jq -n \
    --argjson mouseFactor      "$(read_opt mouse-factor)" \
    --argjson mouseNatural     "$(read_opt mouse-natural)" \
    --argjson padFactor        "$(read_opt pad-factor)" \
    --argjson padNatural       "$(read_opt pad-natural)" \
    --arg     scrollMethod     "$(read_opt scroll-method)" \
    --argjson emulateDiscrete  "$(read_opt emulate-discrete)" \
    --argjson hasTouchpad      "$(cmd_has_touchpad)" \
    --argjson persisted        "$(is_enabled && echo true || echo false)" \
    '{persisted:$persisted, mouseFactor:$mouseFactor, mouseNatural:$mouseNatural,
      padFactor:$padFactor, padNatural:$padNatural,
      scrollMethod:$scrollMethod, emulateDiscrete:$emulateDiscrete,
      hasTouchpad:$hasTouchpad}'
}

cmd_has_touchpad() {
  if hyprctl -j devices 2>/dev/null | jq -e '[.mice[]?.name] | any(test("touchpad|trackpad"; "i"))' >/dev/null 2>&1; then
    echo true
  else
    echo false
  fi
}

# Omarchy drives Hyprland from Lua, and `hyprctl keyword` refuses to touch a
# non-legacy parser ("keyword can't work with non-legacy parsers. Use eval.").
# So a live change is a one-key hl.config() call evaluated in place, which
# merges into the running config instead of replacing it.
lua_for() {
  local key="$1" val="$2"
  case "$key" in
    mouse-factor)     printf 'hl.config({ input = { scroll_factor = %s } })' "$val" ;;
    mouse-natural)    printf 'hl.config({ input = { natural_scroll = %s } })' "$val" ;;
    pad-factor)       printf 'hl.config({ input = { touchpad = { scroll_factor = %s } } })' "$val" ;;
    pad-natural)      printf 'hl.config({ input = { touchpad = { natural_scroll = %s } } })' "$val" ;;
    scroll-method)    printf 'hl.config({ input = { scroll_method = "%s" } })' "$val" ;;
    emulate-discrete) printf 'hl.config({ input = { emulate_discrete_scroll = %s } })' "$val" ;;
    *) return 1 ;;
  esac
}

cmd_set() {
  local code
  code=$(lua_for "$1" "$2") || { echo "omarchy-scroll: unknown key '$1'" >&2; return 1; }
  hyprctl eval "$code" >/dev/null
}

cmd_save() {
  local mf mn pf pn sm ed
  mf=$(read_opt mouse-factor);     mn=$(read_opt mouse-natural)
  pf=$(read_opt pad-factor);       pn=$(read_opt pad-natural)
  sm=$(read_opt scroll-method);    ed=$(read_opt emulate-discrete)

  owns_scroll_lua || return 1
  mkdir -p "$(dirname "$SCROLL_LUA")"
  {
    echo "$HEADER Edits here are overwritten."
    echo "-- Change these from the Scroll settings app, or run: omarchy-scroll --help"
    echo
    echo "hl.config({"
    echo "  input = {"
    echo "    scroll_factor = $mf,"
    echo "    natural_scroll = $mn,"
    echo "    emulate_discrete_scroll = $ed,"
    [[ -n $sm ]] && echo "    scroll_method = \"$sm\","
    echo "    touchpad = {"
    echo "      scroll_factor = $pf,"
    echo "      natural_scroll = $pn,"
    echo "    },"
    echo "  },"
    echo "})"
  } >"$SCROLL_LUA"
}

# scroll.lua is ours only if it is absent, empty, or carries our header. Never
# clobber a file of the same name the user wrote themselves.
owns_scroll_lua() {
  [[ ! -s $SCROLL_LUA ]] && return 0
  head -n1 "$SCROLL_LUA" | grep -qF -- "$HEADER" && return 0
  echo "omarchy-scroll: $SCROLL_LUA was not generated by omarchy-scroll; refusing to overwrite it." >&2
  return 1
}

is_enabled() {
  [[ -f $INPUT_LUA ]] && grep -qF 'require("hypr.scroll")' "$INPUT_LUA"
}

# input.lua is the user's own file: only touched on explicit request, with one
# marked line appended once.
cmd_enable() {
  [[ -f $INPUT_LUA ]] || { echo "omarchy-scroll: $INPUT_LUA not found." >&2; return 1; }
  # Snapshot the current live values first: the require line makes Hyprland
  # reload, and that reload must load what the user is seeing now, not a stale
  # scroll.lua (and the file must exist, or the require would fail).
  cmd_save || return 1
  is_enabled && return 0
  printf '\n%s\n%s\n' "$REQUIRE_COMMENT" "$REQUIRE_LINE" >>"$INPUT_LUA"
}

# Remove only the lines `enable` added, leaving the rest of input.lua as is.
cmd_disable() {
  [[ -f $INPUT_LUA ]] || return 0
  is_enabled || return 0
  local tmp
  tmp=$(mktemp) || return 1
  grep -vxF -e "$REQUIRE_LINE" -e "$REQUIRE_COMMENT" -e 'require("hypr.scroll")' "$INPUT_LUA" \
    | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' >"$tmp"   # drop the blank lines enable left at EOF
  cat "$tmp" >"$INPUT_LUA"   # keep the original file's inode and permissions
  rm -f "$tmp"
}

cmd_reset() {
  owns_scroll_lua || return 1
  [[ -f $SCROLL_LUA ]] && : >"$SCROLL_LUA"
  hyprctl reload >/dev/null
}

cmd_uninstall() {
  cmd_disable || return 1
  if [[ -f $SCROLL_LUA ]] && owns_scroll_lua; then
    rm -f "$SCROLL_LUA"
  fi
  hyprctl reload >/dev/null
}

case "${1:-}" in
  get)   cmd_get ;;
  set)   [[ $# -eq 3 ]] || { usage >&2; exit 1; }; cmd_set "$2" "$3" ;;
  save)  cmd_save ;;
  enable)    cmd_enable ;;
  disable)   cmd_disable ;;
  reset)     cmd_reset ;;
  uninstall) cmd_uninstall ;;
  path)  echo "$SCROLL_LUA" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
